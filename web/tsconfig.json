{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@compartido/*": ["../src/*"] }
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "playwright.config.ts", "../src/core", "../src/lib", "../src/types.ts", "../server/worker.ts", "../__tests__/helpers/hoja.ts"]
}
