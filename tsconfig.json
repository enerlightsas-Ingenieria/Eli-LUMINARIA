{
  "//": "Opciones copiadas de expo/tsconfig.base (SDK 58) en lugar de 'extends': así Vite (web/) puede leer este archivo al compilar el código compartido (src/core, src/lib) sin necesitar que Expo esté instalado en la raíz.",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "types": ["jest", "node"]
  },
  "exclude": ["web", "node_modules", "dist", "android", "ios", "babel.config.js", "metro.config.js", "jest.config.js"]
}
